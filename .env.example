# Copy to `.env` and fill in your values. The .env file is git-ignored.
# Loaded at runtime via flutter_dotenv (declared as an asset in pubspec.yaml).

# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Edge Function used as the crawling proxy (CORS bypass + Postgres cache).
# Defaults to `${SUPABASE_URL}/functions/v1/crawl-proxy` when left blank.
CRAWL_PROXY_URL=

# NOTE: The Claude API key for AI summaries/taste is NOT a client value.
# It is set as a Supabase Edge Function secret (server-side only):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Never put ANTHROPIC_API_KEY in this client .env or the app bundle.
